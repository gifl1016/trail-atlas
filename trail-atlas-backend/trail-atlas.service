[Unit]
Description=Trail Atlas API Backend
After=network.target
Wants=network.target

[Service]
Type=simple
User=trail-atlas
Group=trail-atlas
WorkingDirectory=/opt/trail-atlas/backend
ExecStart=/opt/trail-atlas/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Umgebungsvariablen
Environment=DB_PATH=/var/lib/trail-atlas/trail_atlas.db
Environment=PYTHONUNBUFFERED=1

# Sicherheit
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trail-atlas

# Logging → journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trail-atlas

[Install]
WantedBy=multi-user.target
