# Trail Atlas – Configuration
# Diese Datei wird auf der VM unter /etc/trail-atlas/garmin.env gespeichert.
# Berechtigungen: chmod 600, Owner: trail-atlas
# Wird von systemd (EnvironmentFile) und garmin_sync.py (load_env) gelesen.

# ── Garmin Connect Login ──────────────────────────────────────────────────────
GARMIN_EMAIL=deine@email.com
GARMIN_PASSWORD=dein-garmin-passwort

# ── Trail Atlas API ──────────────────────────────────────────────────────────
# Lokal von der VM aus, daher localhost statt der Domain
API_BASE=http://127.0.0.1:8000

# ── Auth: Session-Secret ─────────────────────────────────────────────────────
# Generieren: python3 -c "import secrets; print(secrets.token_hex(32))"
# WICHTIG: Bei Änderung werden alle bestehenden Sessions invalidiert.
SECRET_KEY=

# ── Auth: Admin-Account ─────────────────────────────────────────────────────
# Wird beim ersten App-Start automatisch angelegt (nur wenn noch kein User existiert).
# Alle bestehenden Aktivitäten werden diesem User zugewiesen.
ADMIN_USER=
ADMIN_PASS=

# ── Auth: Sync-API-Key ──────────────────────────────────────────────────────
# Wird vom Garmin-Sync-Cronjob als X-Sync-Key Header gesendet.
# Generieren: python3 -c "import secrets; print(secrets.token_hex(32))"
SYNC_API_KEY=
